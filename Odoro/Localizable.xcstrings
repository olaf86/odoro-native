    "capture.hint.front" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture upper-body motion from the front camera, centered on shoulders, arms, and wrists. Lower body motion is filled in during stage playback."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前面カメラで肩、腕、手首を中心に上半身の動きを収録します。下半身はステージ再生時に補完します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전면 카메라로 어깨, 팔, 손목 중심의 상반신 동작을 캡처합니다. 하반신은 스테이지 재생 시 보완됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captura movimentos da parte superior do corpo com a câmera frontal, focando em ombros, braços e pulsos. A parte inferior é completada na reprodução do palco."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用前置相機擷取以上半身為主的動作，重點包含肩膀、手臂與手腕。下半身會在舞台播放時補完。"
          }
        }
      }
    },
    "capture.hint.mock" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Using MockMotionSource for simulator testing. The mock dance clip is treated as the capture source."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シミュレータ用の MockMotionSource を使っています。疑似ダンスを収録対象として扱います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시뮬레이터에서는 MockMotionSource를 사용합니다. 모의 댄스 클립을 캡처 소스로 취급합니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa o MockMotionSource no simulador. O clipe de dança simulado é tratado como a fonte de captura."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在模擬器中使用 MockMotionSource。系統會將模擬舞蹈片段視為擷取來源。"
          }
        }
      }
    },
    "capture.hint.rear" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capture a short performance using the rear camera and full body tracking. The app switches to stage playback when you stop recording."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背面カメラで全身を捉え、短い振り付けを収録します。停止するとステージ再生に切り替わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "후면 카메라와 전신 추적을 사용해 짧은 동작을 캡처합니다. 캡처를 멈추면 스테이지 재생으로 전환됩니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captura uma performance curta com a câmera traseira e rastreamento de corpo inteiro. O app muda para a reprodução no palco quando você encerra a gravação."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用後置相機與全身追蹤錄製短片段。停止錄製後會切換到舞台播放。"
          }
        }
      }
    },
