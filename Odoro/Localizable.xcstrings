    "stage.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recorded joint positions are looped as a simplified dancer. This is a mock stage player that will later be replaced with a rigged character."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録した関節位置を簡易ダンサーとしてループ再生しています。将来的にはリグ済みキャラクターへ置き換える前提のモックです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록된 관절 위치를 단순화된 댄서로 반복 재생합니다. 이후 리깅된 캐릭터로 교체될 스테이지 플레이어 목업입니다."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As posições das articulações gravadas são reproduzidas em loop como um dançarino simplificado. Este é um mock do player de palco que depois será substituído por um personagem com rig."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已錄製的關節位置會以簡化舞者的形式循環播放。這是之後將替換為已綁定角色的舞台播放器原型。"
          }
        }
      }
    },
